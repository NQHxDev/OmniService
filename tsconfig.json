{
   "compilerOptions": {
      "module": "nodenext",
      "moduleResolution": "nodenext",
      "resolvePackageJsonExports": true,
      "esModuleInterop": true,
      "isolatedModules": true,
      "declaration": true,
      "removeComments": true,
      "emitDecoratorMetadata": true,
      "experimentalDecorators": true,
      "allowSyntheticDefaultImports": true,
      "target": "ES2023",
      "sourceMap": true,
      "outDir": "./dist",
      "baseUrl": "./",
      "incremental": true,
      "skipLibCheck": true,
      "strictNullChecks": true,
      "forceConsistentCasingInFileNames": true,
      "noImplicitAny": true,
      "strictBindCallApply": true,
      "noFallthroughCasesInSwitch": true,
      "paths": {
         // Gateway (entry point - special case)
         "@/*": ["apps/gateway/src/*"],
         "@gateway/*": ["apps/gateway/src/*"],

         // Microservices - Individual declarations (type-safe)
         "@auth/*": ["apps/auth/src/*"],
         "@user/*": ["apps/user/src/*"],
         "@media/*": ["apps/media/src/*"],
         "@notification/*": ["apps/notification/src/*"],
         "@post/*": ["apps/post/src/*"],
         "@search/*": ["apps/search/src/*"],
         "@commerce/*": ["apps/commerce/src/*"],
         "@supplier/*": ["apps/supplier/src/*"],
         "@order/*": ["apps/order/src/*"],
         "@payment/*": ["apps/payment/src/*"],
         "@product/*": ["apps/product/src/*"],

         // Prisma clients - Convention-based & type-safe
         "@auth/prisma-client": ["apps/auth/src/generated/prisma-client"],
         "@user/prisma-client": ["apps/user/src/generated/prisma-client"],
         "@media/prisma-client": ["apps/media/src/generated/prisma-client"],
         "@notification/prisma-client": ["apps/notification/src/generated/prisma-client"],
         "@post/prisma-client": ["apps/post/src/generated/prisma-client"],
         "@commerce/prisma-client": ["apps/commerce/src/generated/prisma-client"],
         "@supplier/prisma-client": ["apps/supplier/src/generated/prisma-client"],
         "@order/prisma-client": ["apps/order/src/generated/prisma-client"],
         "@payment/prisma-client": ["apps/payment/src/generated/prisma-client"],
         "@product/prisma-client": ["apps/product/src/generated/prisma-client"],
         "@*/prisma-client": ["apps/*/src/generated/prisma-client"],

         // Shared libraries
         "@common": ["libs/common/src"],
         "@common/*": ["libs/common/src/*"],

         // Contracts - Convention-based
         "@contracts/auth": ["libs/contracts/auth/src"],
         "@contracts/auth/*": ["libs/contracts/auth/src/*"],
         "@contracts/user": ["libs/contracts/user/src"],
         "@contracts/user/*": ["libs/contracts/user/src/*"],
         "@contracts/notification": ["libs/contracts/notification/src"],
         "@contracts/notification/*": ["libs/contracts/notification/src/*"],
         "@contracts/search": ["libs/contracts/search/src"],
         "@contracts/search/*": ["libs/contracts/search/src/*"],
         "@contracts/media": ["libs/contracts/media/src"],
         "@contracts/media/*": ["libs/contracts/media/src/*"],
         "@contracts/post": ["libs/contracts/post/src"],
         "@contracts/post/*": ["libs/contracts/post/src/*"],
         "@contracts/health": ["libs/contracts/health/src"],
         "@contracts/health/*": ["libs/contracts/health/src/*"],
         "@contracts/commerce": ["libs/contracts/commerce/src"],
         "@contracts/commerce/*": ["libs/contracts/commerce/src/*"],
         "@contracts/supplier": ["libs/contracts/supplier/src"],
         "@contracts/supplier/*": ["libs/contracts/supplier/src/*"],
         "@contracts/order": ["libs/contracts/order/src"],
         "@contracts/order/*": ["libs/contracts/order/src/*"],
         "@contracts/payment": ["libs/contracts/payment/src"],
         "@contracts/payment/*": ["libs/contracts/payment/src/*"],
         "@contracts/product": ["libs/contracts/product/src"],
         "@contracts/product/*": ["libs/contracts/product/src/*"]
      },
      "jsx": "react-jsx"
   }
}
