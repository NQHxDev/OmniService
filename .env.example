# Global Environment
NODE_ENV=development
LOG_LEVEL=info

# JWT ES256 Configuration
JWT_KEY_ID=omni-auth-key-1
JWT_ALGORITHM=ES256
JWT_SECRET=default-jwt-secret
JWT_ACCESS_TOKEN_EXPIRES_IN=900
JWT_REFRESH_TOKEN_EXPIRES_IN=604800
JWT_EXPIRES_IN=900

# Cookie settings & expiration (milliseconds)
COOKIE_ACCESS_TOKEN_NAME=access_token
COOKIE_REFRESH_TOKEN_NAME=refresh_token
COOKIE_ACCESS_TOKEN_MAX_AGE=900000
COOKIE_REFRESH_TOKEN_MAX_AGE=604800000

# Redis infrastructure
REDIS_HOST=localhost
REDIS_PORT=6379

# PgBouncer Connection Pool
PGBOUNCER_PORT=6432

# RabbitMQ infrastructure & queues
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_USER=guest
RABBITMQ_PASS=guest
RABBIT_MQ_URI=amqp://guest:guest@localhost:5672
RABBIT_MQ_AUTH_SERVICE_QUEUE=auth_queue
RABBIT_MQ_USER_SERVICE_QUEUE=user_queue
RABBIT_MQ_ORDER_SERVICE_QUEUE=order_queue
RABBIT_MQ_NOTIFICATION_SERVICE_QUEUE=notification_queue
RABBIT_MQ_SEARCH_SERVICE_QUEUE=search_queue

# Search HTTP (Health checks & metrics)
SEARCH_HTTP_PORT=3003

# OpenTelemetry Distributed Tracing & Jaeger
OTEL_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
JAEGER_UI_PORT=16686
OTEL_EXPORTER_OTLP_PORT=4318

# Process Compose Orchestrator
PC_PORT_NUM=9999
