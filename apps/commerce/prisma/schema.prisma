// Note: In Prisma 7+, datasource connection URLs (including directUrl for migrations)
// are configured in prisma.config.ts. Prisma CLI reads process.env.DIRECT_URL ?? env('DATABASE_URL')
// from prisma.config.ts to execute migrations via direct Postgres connection.
datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma-client"
}

enum IngredientStatus {
  ACTIVE
  INACTIVE
  DRAFT
}

enum OfferStatus {
  AVAILABLE
  OUT_OF_STOCK
  DISCONTINUED
}

enum CurrencyEnum {
   VND
   USD
   EUR
}

model Category {
  categoryId   String       @id @default(uuid()) @map("category_id") @db.Uuid
  categoryName String       @unique @map("category_name") @db.VarChar(100)
  categorySlug String       @unique @map("category_slug") @db.VarChar(120)
  iconUrl      String?      @map("icon_url")
  version      Int          @default(1)
  deletedAt    DateTime?    @map("deleted_at")
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  ingredients  Ingredient[]

  @@index([categorySlug])
  @@index([deletedAt])
  @@map("categories")
}

model Ingredient {
  ingredientId          String           @id @default(uuid()) @map("ingredient_id") @db.Uuid
  ingredientName        String           @map("ingredient_name") @db.VarChar(150)
  normalizedName        String           @map("normalized_name") @db.VarChar(150)
  ingredientSlug        String           @unique @map("ingredient_slug") @db.VarChar(180)
  ingredientDescription String           @map("ingredient_description") @db.Text
  ingredientImageUrl    String           @map("ingredient_image_url")
  categoryId            String           @map("category_id") @db.Uuid
  defaultUnit           String           @map("default_unit") @db.VarChar(30)
  ingredientStatus      IngredientStatus @default(ACTIVE) @map("ingredient_status")
  version               Int              @default(1)
  deletedAt             DateTime?        @map("deleted_at")
  createdAt             DateTime         @default(now()) @map("created_at")
  updatedAt             DateTime         @updatedAt @map("updated_at")

  category              Category         @relation(fields: [categoryId], references: [categoryId], onDelete: Restrict)
  offers                SupplierProduct[]

  @@index([categoryId])
  @@index([ingredientName])
  @@index([normalizedName])
  @@index([ingredientSlug])
  @@index([ingredientStatus])
  @@index([deletedAt])
  @@index([ingredientStatus, categoryId])
  @@map("ingredients")
}

model SupplierProduct {
  productId       String         @id @default(uuid())       @map("product_id") @db.Uuid
  supplierId      String         @map("supplier_id")        @db.Uuid
  ingredientId    String         @map("ingredient_id")      @db.Uuid
  productSku      String         @map("product_sku")        @db.VarChar(100)
  productTitle    String         @map("product_title")      @db.VarChar(200)
  price           Decimal        @db.Decimal(12, 2)
  currency        CurrencyEnum   @default(VND)              @map("currency")
  originalPrice   Decimal?       @map("original_price")     @db.Decimal(12, 2)
  packageSize     String?        @map("package_size")       @db.VarChar(50)
  stockQuantity   Int            @default(0)                @map("stock_quantity")
  productUrl      String?        @map("product_url")        @db.Text
  productImageUrl String?        @map("product_image_url")  @db.Text
  offerStatus     OfferStatus    @default(AVAILABLE)        @map("offer_status")
  version         Int            @default(1)
  deletedAt       DateTime?      @map("deleted_at")
  createdAt       DateTime       @default(now())            @map("created_at")
  updatedAt       DateTime       @updatedAt                 @map("updated_at")

  ingredient      Ingredient     @relation(fields: [ingredientId], references: [ingredientId], onDelete: Cascade)

  @@unique([supplierId, productSku])
  @@index([supplierId])
  @@index([ingredientId])
  @@index([supplierId, offerStatus])
  @@index([ingredientId, offerStatus])
  @@index([offerStatus])
  @@index([price])
  @@index([deletedAt])
  @@map("supplier_products")
}

model OutboxEvent {
  eventId       String   @id @default(uuid()) @map("event_id") @db.Uuid
  aggregateType String   @map("aggregate_type") @db.VarChar(50)
  aggregateId   String   @map("aggregate_id")
  eventType     String   @map("event_type") @db.VarChar(100)
  payload       Json
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@index([aggregateType, aggregateId])
  @@map("outbox_events")
}
