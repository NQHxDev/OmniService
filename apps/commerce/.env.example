SERVICE_NAME=commerce-service
PORT=3007
GRPC_PORT=50053

# Database configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=omni_service_commerce
POSTGRES_PORT=5443
PGBOUNCER_PORT=6432

# Runtime database URL via PgBouncer (Transaction Pooling)
DATABASE_URL=postgresql://postgres:postgres@localhost:6432/omni_service_commerce?connection_limit=5&pool_timeout=10&pgbouncer=true

# Direct database URL for Prisma Migrations & Seeds (Advisory locks & DDL supported)
DIRECT_URL=postgresql://postgres:postgres@localhost:5443/omni_service_commerce

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# RabbitMQ
RABBITMQ_URI=amqp://guest:guest@localhost:5672
