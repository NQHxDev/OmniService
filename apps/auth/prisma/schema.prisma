// Note: In Prisma 7+, datasource connection URLs (including directUrl for migrations)
// are configured in prisma.config.ts. Prisma CLI reads process.env.DIRECT_URL ?? env('DATABASE_URL')
// from prisma.config.ts to execute migrations via direct Postgres connection.
datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma-client"
}

enum AccountStatus {
  ACTIVE
  INACTIVE
  BLOCKED
  SUSPENDED
  PENDING
  PENDING_ACTIVATION
  REGISTRATION_ABORTED
}

enum SagaStatus {
  STARTED
  EXECUTING
  COMPENSATING
  COMPENSATED
  COMPLETED
  FAILED
}

enum SagaStepStatus {
  PENDING
  EXECUTING
  SUCCEEDED
  FAILED
  COMPENSATING
  COMPENSATED
  COMPENSATION_FAILED
}

enum AuditStatus {
  SUCCESS
  FAILURE
}

model Account {
  accountId       String             @id @default(uuid()) @map("account_id")
  email           String             @unique
  phoneNumber     String?            @unique @map("phone_number")
  passwordHash    String             @map("password_hash")
  status          AccountStatus      @default(ACTIVE)
  isEmailVerified Boolean            @default(false) @map("is_email_verified")
  lastLoginAt     DateTime?          @map("last_login_at")
  version         Int                @default(1)
  deletedAt       DateTime?          @map("deleted_at")
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")
  accountRoles    AccountRole[]
  sessions        AccountSession[]
  auditLogs       SecurityAuditLog[]

  @@index([status])
  @@index([deletedAt])
  @@index([email, status])
  @@map("accounts")
}

model Role {
  roleId          String           @id @default(uuid()) @map("role_id")
  code            String           @unique
  name            String
  description     String?
  version         Int              @default(1)
  deletedAt       DateTime?        @map("deleted_at")
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")
  accountRoles    AccountRole[]
  rolePermissions RolePermission[]

  @@index([code])
  @@index([deletedAt])
  @@map("roles")
}

model Permission {
  permissionId    String           @id @default(uuid()) @map("permission_id")
  code            String           @unique
  name            String
  description     String?
  version         Int              @default(1)
  deletedAt       DateTime?        @map("deleted_at")
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")
  rolePermissions RolePermission[]

  @@index([code])
  @@index([deletedAt])
  @@map("permissions")
}

model AccountRole {
  accountId String   @map("account_id")
  roleId    String   @map("role_id")
  createdAt DateTime @default(now()) @map("created_at")
  account   Account  @relation(fields: [accountId], references: [accountId], onDelete: Cascade)
  role      Role     @relation(fields: [roleId], references: [roleId], onDelete: Cascade)

  @@id([accountId, roleId])
  @@index([roleId])
  @@map("account_roles")
}

model RolePermission {
  roleId       String     @map("role_id")
  permissionId String     @map("permission_id")
  createdAt    DateTime   @default(now()) @map("created_at")
  role         Role       @relation(fields: [roleId], references: [roleId], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [permissionId], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model AccountSession {
  sessionId       String   @id @default(uuid()) @map("session_id")
  accountId       String   @map("account_id")
  refreshTokenJti String   @unique @map("refresh_token_jti")
  refreshTokenHash String? @map("refresh_token_hash")
  deviceType      String?  @map("device_type")
  deviceName      String?  @map("device_name")
  browser         String?
  os              String?
  userAgent       String?  @map("user_agent")
  ipAddress       String?  @map("ip_address")
  city            String?
  region          String?
  country         String?
  countryCode     String?  @map("country_code")
  deviceId        String?  @map("device_id")
  clientType      String?  @default("web") @map("client_type")
  appVersion      String?  @map("app_version")
  isRevoked       Boolean  @default(false) @map("is_revoked")
  lastActiveAt    DateTime @default(now()) @map("last_active_at")
  expiresAt       DateTime @map("expires_at")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  account Account @relation(fields: [accountId], references: [accountId], onDelete: Cascade)

  @@index([accountId, isRevoked])
  @@index([refreshTokenJti])
  @@index([expiresAt])
  @@index([deviceId])
  @@index([clientType])
  @@map("account_sessions")
}

model SecurityAuditLog {
  auditLogId String      @id @default(uuid()) @map("audit_log_id")
  accountId  String?     @map("account_id")
  actorEmail String?     @map("actor_email")
  action     String
  status     AuditStatus @default(SUCCESS)
  ipAddress  String?     @map("ip_address")
  userAgent  String?     @map("user_agent")
  deviceType String?     @map("device_type")
  deviceName String?     @map("device_name")
  browser    String?
  os         String?
  city       String?
  country    String?
  reason     String?
  metadata   Json?
  createdAt  DateTime    @default(now()) @map("created_at")

  account Account? @relation(fields: [accountId], references: [accountId], onDelete: SetNull)

  @@index([accountId, createdAt])
  @@index([actorEmail, createdAt])
  @@index([action, createdAt])
  @@index([status, createdAt])
  @@index([createdAt])
  @@map("security_audit_logs")
}

model OutboxEvent {
  eventId       String   @id @default(uuid()) @map("event_id") @db.Uuid
  aggregateType String   @map("aggregate_type") @db.VarChar(50)
  aggregateId   String   @map("aggregate_id")
  eventType     String   @map("event_type") @db.VarChar(100)
  payload       Json
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@index([aggregateType, aggregateId])
  @@map("outbox_events")
}

model AuditEventStream {
  eventId   String   @id @default(uuid()) @map("event_id")
  streamId  String   @map("stream_id")
  eventType String   @map("event_type")
  version   Int      @default(autoincrement()) @unique
  data      Json
  metadata  Json
  createdAt DateTime @default(now()) @map("created_at")

  @@index([streamId, version])
  @@index([eventType])
  @@map("audit_event_streams")
}

model AccountSecurityScore {
  accountId            String   @id @map("account_id")
  score                Int
  riskLevel            String   @map("risk_level")
  failedLoginAttempts  Int      @default(0) @map("failed_login_attempts")
  successfulLogins     Int      @default(0) @map("successful_logins")
  passwordChanges      Int      @default(0) @map("password_changes")
  suspiciousActivities Int      @default(0) @map("suspicious_activities")
  lastUpdated          DateTime @default(now()) @map("last_updated")

  @@index([riskLevel])
  @@map("account_security_scores")
}

model SagaInstance {
  sagaId       String       @id @default(uuid()) @map("saga_id")
  sagaType     String       @map("saga_type")
  aggregateId  String       @map("aggregate_id")
  currentState SagaStatus   @default(STARTED) @map("current_state")
  currentStep  String?      @map("current_step")
  payload      Json?        @map("payload")
  retryCount   Int          @default(0) @map("retry_count")
  maxRetries   Int          @default(3) @map("max_retries")
  timeoutAt    DateTime     @map("timeout_at")
  lastError    String?      @map("last_error")
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")
  stepLogs     SagaStepLog[]

  @@index([currentState, timeoutAt])
  @@index([aggregateId])
  @@index([sagaType, currentState])
  @@map("saga_instances")
}

model SagaStepLog {
  stepLogId   String         @id @default(uuid()) @map("step_log_id")
  sagaId      String         @map("saga_id")
  stepName    String         @map("step_name")
  status      SagaStepStatus @map("status")
  payload     Json?          @map("payload")
  error       String?        @map("error")
  durationMs  Int?           @map("duration_ms")
  createdAt   DateTime       @default(now()) @map("created_at")

  saga        SagaInstance   @relation(fields: [sagaId], references: [sagaId], onDelete: Cascade)

  @@index([sagaId, createdAt])
  @@index([stepName, status])
  @@map("saga_step_logs")
}
