# Auth service name
SERVICE_NAME=auth-service

# PostgreSQL database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=omni_service_auth
POSTGRES_PORT=5433
PGBOUNCER_PORT=6432

# Runtime database URL via PgBouncer (Transaction Pooling)
DATABASE_URL=postgresql://postgres:postgres@localhost:6432/omni_service_auth?connection_limit=5&pool_timeout=10&pgbouncer=true

# Direct database URL for Prisma Migrations & Seeds (Advisory locks & DDL supported)
DIRECT_URL=postgresql://postgres:postgres@localhost:5433/omni_service_auth

# RabbitMQ Configuration
RABBIT_MQ_NOTIFICATION_SERVICE_QUEUE=notification_queue

# JWT ES256 Key Configuration
JWT_KEY_ID=omni-auth-key-1
JWT_ALGORITHM=ES256
JWT_PRIVATE_KEY_PATH=apps/auth/keys/private.key
JWT_PUBLIC_KEY_PATH=apps/auth/keys/public.key
JWT_ACCESS_TOKEN_EXPIRES_IN=900
JWT_REFRESH_TOKEN_EXPIRES_IN=604800

# Argon2 Configuration
ARGON2_SECRET=default-argon2-salt-secret-key
ARGON2_SALT=default-argon2-salt-secret-key

# Opaque Refresh Token HMAC-SHA256 Secret
REFRESH_TOKEN_SECRET=default-refresh-token-secret-must-be-changed-in-prod-32bytes
