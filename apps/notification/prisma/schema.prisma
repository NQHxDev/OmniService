// Note: In Prisma 7+, datasource connection URLs (including directUrl for migrations)
// are configured in prisma.config.ts. Prisma CLI reads process.env.DIRECT_URL ?? env('DATABASE_URL')
// from prisma.config.ts to execute migrations via direct Postgres connection.
datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma-client"
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
}

model NotificationLog {
  notificationLogId String             @id @default(uuid()) @map("notification_log_id")
  eventId           String?            @unique @map("event_id")
  recipient         String
  channel           String             @default("EMAIL")
  template          String
  payload           Json
  status            NotificationStatus @default(PENDING)
  errorMessage      String?            @map("error_message")
  sentAt            DateTime?          @map("sent_at")
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")

  @@index([recipient])
  @@index([status])
  @@map("notification_logs")
}

model OutboxEvent {
  eventId       String             @id @default(uuid()) @map("event_id")
  aggregateType String             @map("aggregate_type")
  aggregateId   String             @map("aggregate_id")
  eventType     String             @map("event_type")
  payload       Json
  status        NotificationStatus @default(PENDING)
  retryCount    Int                @default(0) @map("retry_count")
  lastError     String?            @map("last_error")
  processedAt   DateTime?          @map("processed_at")
  createdAt     DateTime           @default(now()) @map("created_at")
  updatedAt     DateTime           @updatedAt @map("updated_at")

  @@index([status, createdAt])
  @@index([aggregateType, aggregateId])
  @@map("outbox_events")
}
