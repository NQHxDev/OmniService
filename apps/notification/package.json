{
   "name": "@omni/notification",
   "version": "0.0.1",
   "private": true,
   "scripts": {
      "start": "nest start notification --watch",
      "build": "nest build notification",
      "email:dev": "email dev --dir src/templates",
      "prisma:generate": "dotenv -e .env -- prisma generate --schema=prisma/schema.prisma",
      "prisma:migrate": "dotenv -e .env -- prisma migrate dev --schema=prisma/schema.prisma",
      "prisma:migrate:deploy": "dotenv -e .env -- prisma migrate deploy --schema=prisma/schema.prisma",
      "prisma:push": "dotenv -e .env -- prisma db push --schema=prisma/schema.prisma",
      "prisma:studio": "dotenv -e .env -- prisma studio --schema=prisma/schema.prisma",
      "lint": "eslint \"src/**/*.ts\" --fix"
   },
   "dependencies": {
      "@common": "workspace:*",
      "@nestjs/common": "^11.0.1",
      "@nestjs/config": "^4.0.4",
      "@nestjs/core": "^11.0.1",
      "@nestjs/microservices": "^11.2.6",
      "@prisma/adapter-pg": "7.10.0",
      "@react-email/components": "^1.0.12",
      "@react-email/render": "^2.1.0",
      "pg": "^8.13.1",
      "react": "^19.3.0",
      "react-dom": "^19.3.0",
      "reflect-metadata": "^0.2.2",
      "resend": "^6.30.0",
      "rxjs": "^7.8.1",
      "zod": "^4.6.5"
   },
   "devDependencies": {
      "@prisma/client": "7.10.0",
      "@react-email/ui": "^6.11.0",
      "@types/pg": "^8.11.11",
      "@types/react": "^19.3.0",
      "@types/react-dom": "^19.3.0",
      "prisma": "7.10.0",
      "react-email": "^6.11.0"
   }
}
