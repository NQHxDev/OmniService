# Notification service
SERVICE_NAME=notification-service

# Resend API Key
RESEND_TOKEN=re_your_resend_api_key_here

# Email sender configuration (Domain verified on Resend)
EMAIL_FROM=noreply@zeion.online
EMAIL_FROM_NAME=OmniServices
APP_URL=https://zeion.online

# RabbitMQ configuration
RABBIT_MQ_URI=amqp://guest:guest@localhost:5672
RABBIT_MQ_NOTIFICATION_SERVICE_QUEUE=notification_queue

# PostgreSQL database configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=omni_service_notification
POSTGRES_PORT=5436
PGBOUNCER_PORT=6432

# Runtime database URL via PgBouncer (Transaction Pooling)
DATABASE_URL=postgresql://postgres:postgres@localhost:6432/omni_service_notification?connection_limit=5&pool_timeout=10&pgbouncer=true

# Direct database URL for Prisma Migrations & Seeds (Advisory locks & DDL supported)
DIRECT_URL=postgresql://postgres:postgres@localhost:5436/omni_service_notification
