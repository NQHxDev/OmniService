SERVICE_NAME=payment-service
PORT=3010
GRPC_PORT=50058
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=omni_service_payment
POSTGRES_PORT=5446
PGBOUNCER_PORT=6432

# Runtime database URL via PgBouncer (Transaction Pooling)
DATABASE_URL=postgresql://postgres:postgres@localhost:6432/omni_service_payment?connection_limit=5&pool_timeout=10&pgbouncer=true

# Direct database URL for Prisma Migrations & Seeds (Advisory locks & DDL supported)
DIRECT_URL=postgresql://postgres:postgres@localhost:5446/omni_service_payment

REDIS_HOST=localhost
REDIS_PORT=6379
RABBIT_MQ_URI=amqp://guest:guest@localhost:5672
RABBIT_MQ_PAYMENT_SERVICE_QUEUE=payment_queue
RABBIT_MQ_ORDER_SERVICE_QUEUE=order_queue

# Payment Gateways (Mock / Sandbox Defaults)
VNPAY_TMN_CODE=TEST_TMN_CODE
VNPAY_HASH_SECRET=TEST_HASH_SECRET
VNPAY_PAYMENT_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
MOMO_PARTNER_CODE=MOMO_TEST_PARTNER
MOMO_ACCESS_KEY=MOMO_TEST_ACCESS_KEY
MOMO_SECRET_KEY=MOMO_TEST_SECRET_KEY
MOMO_ENDPOINT=https://test-payment.momo.vn/v2/gateway/api/create
STRIPE_SECRET_KEY=sk_test_default_mock_key
