// Note: In Prisma 7+, datasource connection URLs (including directUrl for migrations)
// are configured in prisma.config.ts. Prisma CLI reads process.env.DIRECT_URL ?? env('DATABASE_URL')
// from prisma.config.ts to execute migrations via direct Postgres connection.
datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma-client"
}

enum PaymentMethodEnum {
  COD
  CREDIT_CARD
  VNPAY
  MOMO
}

enum PaymentStatusEnum {
  PENDING
  PROCESSING
  SUCCESS
  FAILED
  CANCELLED
  REFUNDED
}

enum RefundStatusEnum {
  PENDING
  SUCCESS
  FAILED
}

enum OutboxStatus {
  PENDING
  PROCESSING
  PUBLISHED
  FAILED
}

model PaymentTransaction {
  transactionId         String             @id @default(uuid()) @map("transaction_id") @db.Uuid
  orderId               String             @map("order_id") @db.Uuid
  userId                String             @map("user_id") @db.Uuid
  amount                Decimal            @map("amount") @db.Decimal(14, 2)
  currency              String             @default("VND") @map("currency") @db.VarChar(10)
  paymentMethod         PaymentMethodEnum  @map("payment_method")
  paymentStatus         PaymentStatusEnum  @default(PENDING) @map("payment_status")
  providerTransactionId String?            @map("provider_transaction_id") @db.VarChar(100)
  paymentUrl            String?            @map("payment_url") @db.Text
  failureReason         String?            @map("failure_reason") @db.Text
  metadata              Json?              @map("metadata")
  version               Int                @default(1)
  createdAt             DateTime           @default(now()) @map("created_at")
  updatedAt             DateTime           @updatedAt @map("updated_at")

  refunds               PaymentRefund[]

  @@index([orderId])
  @@index([userId])
  @@index([paymentStatus])
  @@index([providerTransactionId])
  @@index([createdAt])
  @@map("payment_transactions")
}

model PaymentRefund {
  refundId      String           @id @default(uuid()) @map("refund_id") @db.Uuid
  transactionId String           @map("transaction_id") @db.Uuid
  amount        Decimal          @map("amount") @db.Decimal(14, 2)
  reason        String?          @map("reason") @db.Text
  status        RefundStatusEnum @default(PENDING) @map("status")
  createdAt     DateTime         @default(now()) @map("created_at")
  updatedAt     DateTime         @updatedAt @map("updated_at")

  transaction   PaymentTransaction @relation(fields: [transactionId], references: [transactionId], onDelete: Cascade)

  @@index([transactionId])
  @@map("payment_refunds")
}

model OutboxEvent {
  eventId       String       @id @default(uuid()) @map("event_id") @db.Uuid
  aggregateType String       @map("aggregate_type") @db.VarChar(50)
  aggregateId   String       @map("aggregate_id")
  eventType     String       @map("event_type") @db.VarChar(100)
  payload       Json
  status        OutboxStatus @default(PENDING)
  retryCount    Int          @default(0) @map("retry_count")
  lastError     String?      @map("last_error")
  processedAt   DateTime?    @map("processed_at")
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")

  @@index([status, createdAt])
  @@index([aggregateType, aggregateId])
  @@map("outbox_events")
}
