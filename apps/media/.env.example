# Media service configuration
SERVICE_NAME=media-service
NODE_ENV=development

# PostgreSQL database configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=omni_service_media
POSTGRES_PORT=5442
PGBOUNCER_PORT=6432

# Runtime database URL via PgBouncer (Transaction Pooling)
DATABASE_URL=postgresql://postgres:postgres@localhost:6432/omni_service_media?connection_limit=5&pool_timeout=10&pgbouncer=true

# Direct database URL for Prisma Migrations & Seeds (Advisory locks & DDL supported)
DIRECT_URL=postgresql://postgres:postgres@localhost:5442/omni_service_media

# RabbitMQ configuration
RABBIT_MQ_URI=amqp://guest:guest@localhost:5672
RABBIT_MQ_MEDIA_SERVICE_QUEUE=media_queue

# CDN Cloudinary configuration (Images / Avatars)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Cloudflare R2 Configuration (Videos / Large Files / S3 Compatible)
R2_ACCOUNT_ID=your_r2_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=your_r2_bucket_name
R2_ENDPOINT=https://your_r2_account_id.r2.cloudflarestorage.com
R2_PUBLIC_URL=https://pub-your_r2_public_url.r2.dev
