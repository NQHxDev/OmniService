# User service name
SERVICE_NAME=user-service

# PostgreSQL database configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=omni_service_user
POSTGRES_PORT=5439
PGBOUNCER_PORT=6432

# Runtime database URL via PgBouncer (Transaction Pooling)
DATABASE_URL=postgresql://postgres:postgres@localhost:6432/omni_service_user?connection_limit=5&pool_timeout=10&pgbouncer=true

# Direct database URL for Prisma Migrations & Seeds (Advisory locks & DDL supported)
DIRECT_URL=postgresql://postgres:postgres@localhost:5439/omni_service_user

# NebulaGraph configuration
NEBULA_GRAPHD_HOST=localhost
NEBULA_GRAPHD_PORT=9669
NEBULA_USERNAME=root
NEBULA_PASSWORD=nebula
NEBULA_SPACE=social_graph
NEBULA_ADMIN_USERNAME=root
NEBULA_ADMIN_PASSWORD=nebula

# RabbitMQ configuration
RABBIT_MQ_AUTH_SERVICE_QUEUE=auth_queue
RABBIT_MQ_NOTIFICATION_SERVICE_QUEUE=notification_queue
