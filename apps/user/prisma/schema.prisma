// Note: In Prisma 7+, datasource connection URLs (including directUrl for migrations)
// are configured in prisma.config.ts. Prisma CLI reads process.env.DIRECT_URL ?? env('DATABASE_URL')
// from prisma.config.ts to execute migrations via direct Postgres connection.
datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma-client"
}

enum UserStatus {
  ACTIVE
  INACTIVE
  BLOCKED
  SUSPENDED
  PENDING
}

enum FollowStatus {
  PENDING
  ACCEPTED
  REJECTED
  BLOCKED
}

enum Gender {
  MALE
  FEMALE
  OTHER
  PREFER_NOT_TO_SAY
}

model User {
  userId    String     @id @default(uuid()) @map("user_id")
  accountId String     @unique @map("account_id")
  username  String?    @unique
  status    UserStatus @default(ACTIVE)

  deletedAt DateTime? @map("deleted_at")

  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")
  lastActiveAt          DateTime? @map("last_active_at")
  lastUsernameChangedAt DateTime? @map("last_username_changed_at")

  profile  UserProfile?
  stats    UserStats?
  settings UserSettings?

  followers Follow[] @relation("UserFollowers")
  following Follow[] @relation("UserFollowing")

  @@index([username])
  @@index([accountId])
  @@index([status])
  @@index([createdAt])
  @@index([deletedAt])
  @@map("users")
}

model UserProfile {
  profileId   String    @id @default(uuid()) @map("profile_id")
  userId      String    @unique @map("user_id")
  displayName String?   @map("display_name")
  bio         String?   @db.Text
  avatar      String?
  coverImage  String?   @map("cover_image")
  website     String?
  location    String?
  dateOfBirth DateTime? @map("date_of_birth")
  gender      Gender?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@map("user_profiles")
}

model UserStats {
  statsId        String @id @default(uuid()) @map("stats_id")
  userId         String @unique @map("user_id")
  followersCount Int    @default(0) @map("followers_count")
  followingCount Int    @default(0) @map("following_count")
  postsCount     Int    @default(0) @map("posts_count")
  recipesCount   Int    @default(0) @map("recipes_count")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@map("user_stats")
}

model UserSettings {
  settingsId String  @id @default(uuid()) @map("settings_id")
  userId     String  @unique @map("user_id")
  isVerified Boolean @default(false) @map("is_verified")
  isPrivate  Boolean @default(false) @map("is_private")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@map("user_settings")
}

model Follow {
  followId    String       @id @default(uuid()) @map("follow_id")
  followerId  String       @map("follower_id")
  followingId String       @map("following_id")
  status      FollowStatus @default(PENDING)

  deletedAt DateTime? @map("deleted_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  follower  User @relation("UserFollowing", fields: [followerId], references: [userId], onDelete: Cascade)
  following User @relation("UserFollowers", fields: [followingId], references: [userId], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
  @@index([status])
  @@index([createdAt])
  @@index([deletedAt])
  @@map("follows")
}

model OutboxEvent {
  eventId       String   @id @default(uuid()) @map("event_id") @db.Uuid
  aggregateType String   @map("aggregate_type") @db.VarChar(50)
  aggregateId   String   @map("aggregate_id")
  eventType     String   @map("event_type") @db.VarChar(100)
  payload       Json
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@index([aggregateType, aggregateId])
  @@map("outbox_events")
}

model UserEventStream {
  eventId   String   @id @default(uuid()) @map("event_id")
  streamId  String   @map("stream_id")
  eventType String   @map("event_type")
  version   Int      @default(autoincrement()) @unique
  data      Json
  metadata  Json
  createdAt DateTime @default(now()) @map("created_at")

  @@index([streamId, version])
  @@index([eventType])
  @@map("user_event_streams")
}

model UserActivitySummary {
  userId              String    @id @map("user_id")
  totalEvents         Int       @default(0) @map("total_events")
  lastEventType       String?   @map("last_event_type")
  lastEventAt         DateTime? @map("last_event_at")
  profileUpdatesCount Int       @default(0) @map("profile_updates_count")
  followActionsCount  Int       @default(0) @map("follow_actions_count")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  @@map("user_activity_summaries")
}
