datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma-client"
}

model WhoCategory {
  code        String    @id @map("code") @db.VarChar(50)
  name        String    @map("name") @db.VarChar(150)
  description String    @map("description") @db.Text
  examples    String    @map("examples") @db.Text
  order       Int       @default(0) @map("order")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  products    Product[]

  @@map("who_categories")
}

model Product {
  productId         String           @id @default(uuid()) @map("product_id") @db.Uuid
  supplierId        String           @map("supplier_id") @db.Uuid
  whoCategoryCode   String           @map("who_category_code") @db.VarChar(50)
  productName       String           @map("product_name") @db.VarChar(200)
  normalizedName    String           @map("normalized_name") @db.VarChar(200)
  productSlug       String           @unique @map("product_slug") @db.VarChar(250)
  description       String           @map("description") @db.Text
  origin            String?          @map("origin") @db.VarChar(100)
  storageCondition  String?          @map("storage_condition") @db.VarChar(200)
  shelfLifeDays     Int?             @map("shelf_life_days")
  images            String[]         @default([]) @map("images")
  status            String           @default("DRAFT") @map("status") @db.VarChar(30)
  moderationStatus  String           @default("PENDING_APPROVAL") @map("moderation_status") @db.VarChar(30)
  rejectionReason   String?          @map("rejection_reason") @db.Text
  moderatedBy       String?          @map("moderated_by") @db.VarChar(100)
  moderatedAt       DateTime?        @map("moderated_at")
  version           Int              @default(1) @map("version")
  deletedAt         DateTime?        @map("deleted_at")
  createdAt         DateTime         @default(now()) @map("created_at")
  updatedAt         DateTime         @updatedAt @map("updated_at")

  whoCategory       WhoCategory      @relation(fields: [whoCategoryCode], references: [code])
  variants          ProductVariant[]

  @@index([supplierId])
  @@index([whoCategoryCode])
  @@index([status])
  @@index([moderationStatus])
  @@index([deletedAt])
  @@map("products")
}

model ProductVariant {
  variantId         String          @id @default(uuid()) @map("variant_id") @db.Uuid
  productId         String          @map("product_id") @db.Uuid
  sku               String          @unique @map("sku") @db.VarChar(100)
  variantName       String          @map("variant_name") @db.VarChar(150)
  unit              String          @map("unit") @db.VarChar(50)
  packSize          String?         @map("pack_size") @db.VarChar(50)
  price             Decimal         @map("price") @db.Decimal(14, 2)
  originalPrice     Decimal?        @map("original_price") @db.Decimal(14, 2)
  currency          String          @default("VND") @map("currency") @db.VarChar(10)
  stockQuantity     Int             @default(0) @map("stock_quantity")
  reservedQuantity  Int             @default(0) @map("reserved_quantity")
  lowStockThreshold Int             @default(10) @map("low_stock_threshold")
  isDefault         Boolean         @default(false) @map("is_default")
  status            String          @default("AVAILABLE") @map("status") @db.VarChar(30)
  version           Int             @default(1) @map("version")
  deletedAt         DateTime?       @map("deleted_at")
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")

  product           Product         @relation(fields: [productId], references: [productId], onDelete: Cascade)
  stockMovements    StockMovement[]

  @@index([productId])
  @@index([sku])
  @@index([status])
  @@index([deletedAt])
  @@map("product_variants")
}

model StockMovement {
  movementId    String         @id @default(uuid()) @map("movement_id") @db.Uuid
  variantId     String         @map("variant_id") @db.Uuid
  movementType  String         @map("movement_type") @db.VarChar(30)
  quantity      Int            @map("quantity")
  balanceAfter  Int            @map("balance_after")
  referenceType String?        @map("reference_type") @db.VarChar(50)
  referenceId   String?        @map("reference_id") @db.VarChar(100)
  reason        String?        @map("reason") @db.VarChar(255)
  createdAt     DateTime       @default(now()) @map("created_at")

  variant       ProductVariant @relation(fields: [variantId], references: [variantId], onDelete: Cascade)

  @@index([variantId])
  @@index([createdAt])
  @@map("stock_movements")
}

model OutboxEvent {
  eventId       String    @id @default(uuid()) @map("event_id") @db.Uuid
  aggregateType String    @map("aggregate_type") @db.VarChar(50)
  aggregateId   String    @map("aggregate_id")
  eventType     String    @map("event_type") @db.VarChar(100)
  payload       Json
  status        String    @default("PENDING") @map("status") @db.VarChar(20)
  retryCount    Int       @default(0) @map("retry_count")
  lastError     String?   @map("last_error") @db.Text
  processedAt   DateTime? @map("processed_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@index([status, createdAt])
  @@index([aggregateType, aggregateId])
  @@map("outbox_events")
}
