// Note: In Prisma 7+, datasource connection URLs (including directUrl for migrations)
// are configured in prisma.config.ts. Prisma CLI reads process.env.DIRECT_URL ?? env('DATABASE_URL')
// from prisma.config.ts to execute migrations via direct Postgres connection.
datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma-client"
}

enum OrderStatusEnum {
  PENDING
  AWAITING_PAYMENT
  CONFIRMED
  PROCESSING
  SHIPPING
  DELIVERED
  COMPLETED
  CANCELLED
  REFUNDED
}

enum PaymentMethodEnum {
  COD
  CREDIT_CARD
  VNPAY
  MOMO
}

enum PaymentStatusEnum {
  PENDING
  PROCESSING
  SUCCESS
  FAILED
  CANCELLED
  REFUNDED
}

enum OutboxStatus {
  PENDING
  PROCESSING
  PUBLISHED
  FAILED
}

model Order {
  orderId         String            @id @default(uuid()) @map("order_id") @db.Uuid
  orderNumber     String            @unique @map("order_number") @db.VarChar(50)
  userId          String            @map("user_id") @db.Uuid
  orderStatus     OrderStatusEnum   @default(AWAITING_PAYMENT) @map("order_status")
  paymentMethod   PaymentMethodEnum @default(COD) @map("payment_method")
  paymentStatus   PaymentStatusEnum @default(PENDING) @map("payment_status")
  totalAmount     Decimal           @map("total_amount") @db.Decimal(14, 2)
  shippingFee     Decimal           @default(0) @map("shipping_fee") @db.Decimal(12, 2)
  shippingAddress String            @map("shipping_address") @db.Text
  receiverName    String            @map("receiver_name") @db.VarChar(100)
  receiverPhone   String            @map("receiver_phone") @db.VarChar(20)
  note            String?           @map("note") @db.Text
  version         Int               @default(1)
  deletedAt       DateTime?         @map("deleted_at")
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")

  items           OrderItem[]

  @@index([userId])
  @@index([orderStatus])
  @@index([paymentStatus])
  @@index([createdAt])
  @@map("orders")
}

model OrderItem {
  orderItemId String   @id @default(uuid()) @map("order_item_id") @db.Uuid
  orderId     String   @map("order_id") @db.Uuid
  productId   String   @map("product_id") @db.Uuid
  productName String   @map("product_name") @db.VarChar(200)
  quantity    Int      @map("quantity")
  unitPrice   Decimal  @map("unit_price") @db.Decimal(14, 2)
  totalPrice  Decimal  @map("total_price") @db.Decimal(14, 2)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  order       Order    @relation(fields: [orderId], references: [orderId], onDelete: Cascade)

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

model OutboxEvent {
  eventId       String       @id @default(uuid()) @map("event_id") @db.Uuid
  aggregateType String       @map("aggregate_type") @db.VarChar(50)
  aggregateId   String       @map("aggregate_id")
  eventType     String       @map("event_type") @db.VarChar(100)
  payload       Json
  status        OutboxStatus @default(PENDING)
  retryCount    Int          @default(0) @map("retry_count")
  lastError     String?      @map("last_error")
  processedAt   DateTime?    @map("processed_at")
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")

  @@index([status, createdAt])
  @@index([aggregateType, aggregateId])
  @@map("outbox_events")
}
