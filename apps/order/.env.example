SERVICE_NAME=order-service
PORT=3009
GRPC_PORT=50057
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=omni_service_order
POSTGRES_PORT=5445
PGBOUNCER_PORT=6432

# Runtime database URL via PgBouncer (Transaction Pooling)
DATABASE_URL=postgresql://postgres:postgres@localhost:6432/omni_service_order?connection_limit=5&pool_timeout=10&pgbouncer=true

# Direct database URL for Prisma Migrations & Seeds (Advisory locks & DDL supported)
DIRECT_URL=postgresql://postgres:postgres@localhost:5445/omni_service_order

REDIS_HOST=localhost
REDIS_PORT=6379
RABBIT_MQ_URI=amqp://guest:guest@localhost:5672
RABBIT_MQ_ORDER_SERVICE_QUEUE=order_queue
RABBIT_MQ_PAYMENT_SERVICE_QUEUE=payment_queue
