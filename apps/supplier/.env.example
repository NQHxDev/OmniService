# Node Environment & Service Name
NODE_ENV=development
SERVICE_NAME=supplier-service

# HTTP Server & gRPC Ports
PORT=3008
GRPC_PORT=50054

# PostgreSQL Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=omni_service_supplier
POSTGRES_PORT=5444
PGBOUNCER_PORT=6432

# Runtime database URL via PgBouncer (Transaction Pooling)
DATABASE_URL=postgresql://postgres:postgres@localhost:6432/omni_service_supplier?connection_limit=5&pool_timeout=10&pgbouncer=true

# Direct database URL for Prisma Migrations & Seeds (Advisory locks & DDL supported)
DIRECT_URL=postgresql://postgres:postgres@localhost:5444/omni_service_supplier

# RabbitMQ Configuration
RABBITMQ_URI=amqp://guest:guest@localhost:5672

# Redis Cache Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
