// Note: In Prisma 7+, datasource connection URLs (including directUrl for migrations)
// are configured in prisma.config.ts. Prisma CLI reads process.env.DIRECT_URL ?? env('DATABASE_URL')
// from prisma.config.ts to execute migrations via direct Postgres connection.
datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma-client"
}

enum SupplierStatus {
  ACTIVE
  PENDING
  SUSPENDED
}

enum MemberStatus {
  ACTIVE
  INVITED
  SUSPENDED
}

model Supplier {
  supplierId      String           @id @default(uuid()) @map("supplier_id")
  supplierName    String           @map("supplier_name") @db.VarChar(150)
  supplierSlug    String           @unique @map("supplier_slug") @db.VarChar(180)
  supplierCode    String           @unique @map("supplier_code") @db.VarChar(50)
  contactEmail    String?          @map("contact_email") @db.VarChar(100)
  contactPhone    String?          @map("contact_phone") @db.VarChar(30)
  address         String?          @db.VarChar(255)
  city            String?          @db.VarChar(100)
  rating          Float            @default(5.0)
  isVerified      Boolean          @default(false) @map("is_verified")
  supplierStatus  SupplierStatus   @default(ACTIVE) @map("supplier_status")
  supplierLogoUrl String?          @map("supplier_logo_url")
  version         Int              @default(1)
  deletedAt       DateTime?        @map("deleted_at")
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")

  members         SupplierMember[]

  @@index([supplierSlug])
  @@index([supplierCode])
  @@index([supplierStatus])
  @@index([city])
  @@index([deletedAt])
  @@map("suppliers")
}

model SupplierMember {
  memberId     String        @id @default(uuid()) @map("member_id")
  supplierId   String?       @map("supplier_id")
  accountId    String        @unique @map("account_id")
  email        String        @db.VarChar(100)
  role         String        @default("SUPPLIER_ADMIN") @db.VarChar(50)
  memberStatus MemberStatus  @default(ACTIVE) @map("member_status")
  joinedAt     DateTime?     @map("joined_at")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")
  deletedAt    DateTime?     @map("deleted_at")

  supplier     Supplier?     @relation(fields: [supplierId], references: [supplierId], onDelete: Cascade)

  @@index([accountId])
  @@index([supplierId])
  @@index([email])
  @@index([memberStatus])
  @@index([deletedAt])
  @@map("supplier_members")
}

model OutboxEvent {
  eventId       String   @id @default(uuid()) @map("event_id") @db.Uuid
  aggregateType String   @map("aggregate_type") @db.VarChar(50)
  aggregateId   String   @map("aggregate_id")
  eventType     String   @map("event_type") @db.VarChar(100)
  payload       Json
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@index([aggregateType, aggregateId])
  @@map("outbox_events")
}
