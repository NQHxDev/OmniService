{
   "annotations": {
      "list": [
         {
            "builtIn": 1,
            "datasource": "-- Grafana --",
            "enable": true,
            "hide": true,
            "name": "Annotations & Alerts",
            "type": "dashboard"
         }
      ]
   },
   "editable": true,
   "fiscalYearStartMonth": 0,
   "graphTooltip": 1,
   "id": null,
   "links": [],
   "liveNow": false,
   "panels": [
      {
         "collapsed": false,
         "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
         "id": 100,
         "title": "PgBouncer Connection Pooling Golden Signals",
         "type": "row"
      },
      {
         "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
         "fieldConfig": {
            "defaults": {
               "color": { "mode": "palette-classic" },
               "custom": { "axisCenteredZero": false, "axisColorMode": "text", "drawStyle": "line", "fillOpacity": 15 },
               "unit": "short"
            }
         },
         "gridPos": { "h": 8, "w": 12, "x": 0, "y": 1 },
         "id": 1,
         "options": {
            "legend": { "calcs": ["mean", "max", "lastNotNull"], "displayMode": "table", "placement": "bottom" }
         },
         "targets": [
            {
               "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
               "editorMode": "code",
               "expr": "sum(pgbouncer_pools_client_waiting_connections) by (database)",
               "legendFormat": "Waiting Clients (Queue): {{database}}",
               "range": true,
               "refId": "A"
            }
         ],
         "title": "Client Waiting Connections (Connection Queue Pressure)",
         "type": "timeseries"
      },
      {
         "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
         "fieldConfig": {
            "defaults": {
               "color": { "mode": "palette-classic" },
               "custom": { "axisCenteredZero": false, "axisColorMode": "text", "drawStyle": "line", "fillOpacity": 15 },
               "unit": "short"
            }
         },
         "gridPos": { "h": 8, "w": 12, "x": 12, "y": 1 },
         "id": 2,
         "options": {
            "legend": { "calcs": ["mean", "max", "lastNotNull"], "displayMode": "table", "placement": "bottom" }
         },
         "targets": [
            {
               "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
               "editorMode": "code",
               "expr": "sum(pgbouncer_pools_server_active_connections) by (database)",
               "legendFormat": "Server Active: {{database}}",
               "range": true,
               "refId": "A"
            },
            {
               "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
               "editorMode": "code",
               "expr": "sum(pgbouncer_pools_server_idle_connections) by (database)",
               "legendFormat": "Server Idle: {{database}}",
               "range": true,
               "refId": "B"
            }
         ],
         "title": "Server Connections to PostgreSQL (Active vs Idle)",
         "type": "timeseries"
      },
      {
         "collapsed": false,
         "gridPos": { "h": 1, "w": 24, "x": 0, "y": 9 },
         "id": 101,
         "title": "Client Load & PostgreSQL Backend Activity",
         "type": "row"
      },
      {
         "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
         "fieldConfig": {
            "defaults": {
               "color": { "mode": "palette-classic" },
               "custom": { "axisCenteredZero": false, "axisColorMode": "text", "drawStyle": "line", "fillOpacity": 15 },
               "unit": "short"
            }
         },
         "gridPos": { "h": 8, "w": 12, "x": 0, "y": 10 },
         "id": 3,
         "options": {
            "legend": { "calcs": ["mean", "max", "lastNotNull"], "displayMode": "table", "placement": "bottom" }
         },
         "targets": [
            {
               "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
               "editorMode": "code",
               "expr": "sum(pgbouncer_pools_client_active_connections) by (database)",
               "legendFormat": "Client Active: {{database}}",
               "range": true,
               "refId": "A"
            }
         ],
         "title": "Client Active Connections from Microservices Pods",
         "type": "timeseries"
      },
      {
         "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
         "fieldConfig": {
            "defaults": {
               "color": { "mode": "thresholds" },
               "thresholds": {
                  "mode": "absolute",
                  "steps": [
                     { "color": "green", "value": null },
                     { "color": "yellow", "value": 20 },
                     { "color": "red", "value": 30 }
                  ]
               },
               "unit": "short"
            }
         },
         "gridPos": { "h": 8, "w": 12, "x": 12, "y": 10 },
         "id": 4,
         "options": {
            "legend": { "calcs": ["mean", "max", "lastNotNull"], "displayMode": "table", "placement": "bottom" }
         },
         "targets": [
            {
               "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
               "editorMode": "code",
               "expr": "pg_stat_activity_count{state=\"active\"}",
               "legendFormat": "PostgreSQL Active Backends (Target <= 30)",
               "range": true,
               "refId": "A"
            }
         ],
         "title": "PostgreSQL Backend Processes (Target <= 30)",
         "type": "timeseries"
      }
   ],
   "refresh": "5s",
   "schemaVersion": 38,
   "style": "dark",
   "tags": ["pgbouncer", "postgresql", "database", "connection-pooling"],
   "templating": {
      "list": [
